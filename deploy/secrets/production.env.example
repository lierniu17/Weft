# Secrets for production. Copy to deploy/secrets/production.env (untracked) and fill in;
# never commit it. Use values different from stage.
# The passwords end up in a connection URL: use URL-safe values (openssl rand -hex 24).
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
# openssl rand -hex 32 (changing it logs every user out)
SESSION_SECRET=
# LLM providers (ADR-0002)
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
