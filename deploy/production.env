# Production. No secrets here; those live in the untracked deploy/secrets/production.env
# (copy production.env.example). Never run e2e:bot against production.
WEFT_ENV=production
# Relative to deploy/ (where compose.yml lives).
WEFT_SECRETS_FILE=secrets/production.env
# The TLS reverse proxy on the server forwards to 127.0.0.1:8090.
WEFT_WEB_BIND=127.0.0.1
WEFT_WEB_PORT=8090
NEO4J_HEAP=1G
NEO4J_PAGECACHE=512M
DAILY_ENTRY_LIMIT=50
DAILY_ASK_LIMIT=100
SESSION_COOKIE_NAME=weft_session
# The session cookie only travels over https (browsers also accept it on http://localhost).
SESSION_COOKIE_SECURE=true
