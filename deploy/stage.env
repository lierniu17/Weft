# Stage: the rehearsal environment (real models, one e2e:bot round). No secrets here;
# those live in the untracked deploy/secrets/stage.env (copy stage.env.example).
WEFT_ENV=stage
# Relative to deploy/ (where compose.yml lives).
WEFT_SECRETS_FILE=secrets/stage.env
# The web container is the only published port. 127.0.0.1 keeps it local / behind a
# reverse proxy on the server; use 0.0.0.0 to expose it directly.
WEFT_WEB_BIND=127.0.0.1
WEFT_WEB_PORT=8080
NEO4J_HEAP=512M
NEO4J_PAGECACHE=256M
DAILY_ENTRY_LIMIT=50
DAILY_ASK_LIMIT=100
SESSION_COOKIE_NAME=weft_stage_session
# Stage is reached over plain http (localhost / intranet); production is https-only.
SESSION_COOKIE_SECURE=false
