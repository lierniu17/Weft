{
  "request": {
    "method": "POST",
    "path": "/compatible-mode/v1/embeddings",
    "body": {
      "model": "text-embedding-v4",
      "input": [
        "黄丽",
        "老张的女儿",
        "黄丽在中学工作",
        "老张的女儿经历了高考",
        "中学",
        "高考"
      ],
      "dimensions": 1024,
      "encoding_format": "float"
    }
  },
  "response": {
    "status_code": 503,
    "content_type": "application/json",
    "json": true,
    "body": {
      "error": {
        "message": "embeddings are not available in e2e"
      }
    }
  }
}