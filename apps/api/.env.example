# Weft API settings. Copy to apps/api/.env (never commit .env) and fill in secrets.
# Every key here maps 1:1 to a field of weft.settings.Settings (a unit test enforces it).

# --- databases (docker-compose.yml at the repo root) ---
DATABASE_URL=postgresql+asyncpg://weft:weft@localhost:5432/weft
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=weft-dev-password

# --- LLM providers (ADR-0002, both OpenAI-compatible) ---
# DeepSeek: chat, extraction, matching, Ask
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
# Qwen embeddings via DashScope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
LLM_TIMEOUT_SECONDS=60

# --- LLM record / replay (tests) ---
# off: call providers; record: call providers and save fixtures; replay: fixtures only, missing fixture fails
LLM_REPLAY_MODE=off
LLM_FIXTURES_DIR=tests/fixtures/llm

# --- daily usage limits, Beijing-time day (AC-40) ---
DAILY_ENTRY_LIMIT=50
DAILY_ASK_LIMIT=100

# --- sessions (httpOnly cookie) ---
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=weft_session
SESSION_MAX_AGE_DAYS=30
SESSION_COOKIE_SECURE=false

# --- Graphiti (ADR-0001): telemetry must stay off; true is rejected at startup ---
GRAPHITI_TELEMETRY_ENABLED=false
